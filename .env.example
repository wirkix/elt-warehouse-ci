# --- balldontlie API ---
# Free signup at https://app.balldontlie.io/signup. Free tier is 5 req/min;
# the extract client throttles to match this, don't raise it without a paid plan.
BALLDONTLIE_API_KEY=

# --- Databricks (Community Edition) ---
# Workspace hostname, no https:// prefix, e.g. dbc-a1b2c3d4-e5f6.cloud.databricks.com
DATABRICKS_HOST=
# SQL warehouse HTTP path, from the warehouse's "Connection details" tab,
# e.g. /sql/1.0/warehouses/abcdef1234567890
DATABRICKS_HTTP_PATH=
# Personal access token, from User Settings -> Developer -> Access tokens
DATABRICKS_TOKEN=
# Catalog/schema the loader lands raw JSON into and dbt reads from.
# Databricks Free Edition (formerly Community Edition) runs Unity Catalog
# by default with a single preconfigured catalog named "workspace" -- no
# hive_metastore, no ability to create additional catalogs on the free tier.
DATABRICKS_CATALOG=workspace
DATABRICKS_STAGING_SCHEMA=nba_staging
DATABRICKS_MARTS_SCHEMA=nba_marts
