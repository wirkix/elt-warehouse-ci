# Copy to ~/.dbt/profiles.yml (or set DBT_PROFILES_DIR=./dbt) and fill in
# real values -- or leave the env_var() calls as-is and export the same
# vars this repo's extract/ layer uses (see ../.env.example).
nba_warehouse:
  target: dev
  outputs:
    dev:
      type: databricks
      catalog: "{{ env_var('DATABRICKS_CATALOG', 'workspace') }}"
      schema: dbt_default  # unused directly -- see macros/generate_schema_name.sql
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      threads: 4
      # The legacy Thrift transport 404s against this Free Edition
      # serverless warehouse -- only the newer Statement Execution API
      # (SEA) transport works externally here (see extract/landing.py).
      connection_parameters:
        use_sea: true
