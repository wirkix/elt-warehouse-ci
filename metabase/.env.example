# Copy to .env on the VM (gitignored, never commit the real values).
# Generate each with: openssl rand -base64 32
#
# MB_SESSION_SECRET_KEY -- signs Metabase's session cookies. Without it,
# anyone with read access to the app DB can forge a session and
# impersonate any user.
MB_SESSION_SECRET_KEY=

# MB_ENCRYPTION_SECRET_KEY -- encrypts stored DB credentials (e.g. the
# Databricks PAT) at rest in Metabase's own app DB. Setting this on an
# instance that already has unencrypted credentials requires a one-time
# migration -- see SETUP.md step 5.
MB_ENCRYPTION_SECRET_KEY=
